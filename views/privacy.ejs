<%- include('partials/head', { s, url, nonce, path: '/privacy', pageTitle: 'سياسة الخصوصية | ' + s.company.name, pageDesc: 'سياسة الخصوصية وطريقة استخدام البيانات في ' + s.company.name }) %>
<body id="top">
<%- include('partials/header', { s, base: '/' }) %>
<main id="main" class="legal">
  <div class="wrap legal-in">
    <h1>سياسة الخصوصية</h1>
    <% if (s.privacy.lastUpdated) { %><p class="muted">آخر تحديث: <%= s.privacy.lastUpdated %></p><% } %>
    <% (s.privacy.body || '').split(/\n{2,}/).forEach((block) => {
         const lines = block.split('\n');
         if (lines.length > 1 && lines[0].length < 60) { %>
      <h2><%= lines[0] %></h2><p><%= lines.slice(1).join(' ') %></p>
    <% } else { %><p><%= block %></p><% } }) %>
    <p><a class="btn btn-primary" href="/#request">العودة إلى طلب المعاينة</a></p>
  </div>
</main>
<%- include('partials/footer', { s, year, base: '/' }) %>
<script src="/js/site.js" defer></script>
</body>
</html>
